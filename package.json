{
  "name": "dropguard-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "DropGuard: Shopify & IP Infringement Radar Monorepo",
  "workspaces": [
    "extension",
    "server"
  ],
  "scripts": {
    "build": "npm run build --workspace=extension && npm run build --workspace=server",
    "build:extension": "npm run build --workspace=extension",
    "build:server": "npm run build --workspace=server",
    "deploy:server": "npm run deploy --workspace=server",
    "preview:server": "npm run preview --workspace=server",
    "dev:server": "npm run dev --workspace=server",
    "dev:extension": "npm run dev --workspace=extension",
    "package": "VITE_API_BASE_URL=https://dropguard-api.onrender.com npm run build:extension && (cd extension/dist && zip -q -r -FS ../../dropguard-extension-v1.0.0.zip .)",
    "test": "tsx test_verification.ts"
  },
  "devDependencies": {
    "puppeteer-core": "^25.16.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
